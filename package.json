{
  "name": "aura-ecommerce",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm run prisma:generate -w @aura/db",
    "db:migrate": "npm run prisma:migrate -w @aura/db",
    "db:seed": "npm run prisma:seed -w @aura/db",
    "db:reset": "npm run prisma:reset -w @aura/db",
    "dev": "concurrently -n backend,frontend,admin -c blue,green,magenta \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:admin\"",
    "dev:backend": "npm run dev -w @aura/backend",
    "dev:frontend": "npm run dev -w @aura/frontend",
    "dev:admin": "npm run dev -w @aura/admin",
    "build": "npm run build -w @aura/backend && npm run build -w @aura/frontend && npm run build -w @aura/admin",
    "setup": "npm install && npm run db:generate && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
